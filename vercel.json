{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/welcome", "destination": "/welcome.html" }, { "source": "/project", "destination": "/project.html" }],
  "functions": {
    "api/environment.js": { "maxDuration": 30 },
    "api/closures.js": { "maxDuration": 30 },
    "api/transit.js": { "maxDuration": 30 },
    "api/voice.js": { "maxDuration": 30 }
  }
}
