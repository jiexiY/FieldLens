# Optional, local-development-only Google Maps demo key. Never commit .env.local.
# Demo credentials are prohibited in production; the production build excludes this integration.
VITE_GOOGLE_MAPS_DEMO_KEY=

# Optional server-side speech credentials. NEVER add a VITE_ prefix.
# Production is configured in Vercel, not this file. Keep real values in ignored .env.local.
ELEVENLAB_API_KEY=
